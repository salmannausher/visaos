---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';

const ds160Faq = await getEntry('sources', 'dos-ds160-faq');

if (!ds160Faq) {
  throw new Error('Required official source metadata is missing for the problem-solving hub.');
}
---
<Base title="U.S. Visa Problem-Solving Hub | VisaOS" description="Understand common U.S. visa application issues and identify reliable official support sources.">
  <div class="wrap article">
    <p class="eyebrow">Problem-solving hub</p>
    <h1>When a visa application doesn't go as expected</h1>
    <p class="lead">Start with the issue, the application stage, and the official instructions for your consular location.</p>
    <div class="grid">
      <article class="panel">
        <h3>DS-160 questions</h3>
        <p>Consult the <a href={ds160Faq.data.url}>official DS-160 FAQ</a> before changing submitted information.</p>
      </article>
      <article class="panel">
        <h3>Scheduling problems</h3>
        <p>Check the official appointment provider and U.S. Mission guidance for the application location.</p>
      </article>
      <article class="panel">
        <h3>Passport return</h3>
        <p>Use the provider or consular instructions applicable to your case; do not share personal tracking data on public forums.</p>
      </article>
    </div>
    <div class="notice">VisaOS cannot access official visa accounts or change government application records.</div>
  </div>
</Base>
