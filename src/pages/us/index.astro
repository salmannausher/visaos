---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const visitorVisa = await getEntry('sources', 'dos-visitor-visa');
const ds160Overview = await getEntry('sources', 'dos-ds160-overview');
const waitTimes = await getEntry('sources', 'dos-global-wait-times');

if (!visitorVisa || !ds160Overview || !waitTimes) {
  throw new Error('Required official source metadata is missing for the U.S. visa hub.');
}
---
<Base title="Official U.S. Visa Information Sources | VisaOS" description="Find verified Department of State starting points for visitor visas, the DS-160 and current visa interview wait-time information.">
  <div class="wrap article">
    <p class="eyebrow">U.S. visa knowledge hub</p>
    <h1>U.S. Visa Information</h1>
    <p class="lead">Start by identifying your travel purpose and the applicable visa category. Always verify requirements and instructions against official U.S. government sources.</p>
    <div class="notice">VisaOS provides independent navigation, not government services or individualized legal advice. Confirm current requirements on the linked official pages.</div>
    <h2>Official starting points</h2>
    <ul>
      <li><a href={visitorVisa.data.url}>U.S. visitor visa information (Department of State)</a></li>
      <li><a href={ds160Overview.data.url}>DS-160 overview (Department of State)</a></li>
      <li><a href={waitTimes.data.url}>Global visa wait times (Department of State)</a></li>
    </ul>
    <h2>Application problems</h2>
    <p><a href="/us/problems/">Common visa problems →</a></p>
    <h2>VisaOS guides</h2>
    <ul>
      <li><a href="/us/visitor-visa/">B-1, B-2 and B-1/B-2 visitor visa guide</a></li>
      <li><a href="/us/ds-160/">What the DS-160 is and where it fits</a></li>
      <li><a href="/us/ds-160/save-and-return/">Saving a DS-160 and returning later</a></li>
      <li><a href="/us/visa-wait-times/">How to read U.S. visa appointment wait times</a></li>
      <li><a href="/us/from/pakistan/visitor-visa/">U.S. visitor visa from Pakistan: official starting points</a></li>
    </ul>
  </div>
</Base>
