---
import { getEntry } from 'astro:content';
import Base from '../../../../layouts/Base.astro';

const usVisas = await getEntry('sources', 'dos-us-visas');
const pakistanVisas = await getEntry('sources', 'us-mission-pakistan-visas');

if (!usVisas || !pakistanVisas) {
  throw new Error('Required official source metadata is missing for the Pakistan guide.');
}
---
<Base title="U.S. Visa From Pakistan — Starting Resources | VisaOS" description="Official starting points and key questions for U.S. visa applicants applying from Pakistan.">
  <div class="wrap article">
    <p class="eyebrow">Country-specific starting guide</p>
    <h1>Applying for a U.S. Visa From Pakistan</h1>
    <p class="lead">An overview of what to verify before beginning an application. This page intentionally avoids unverified appointment, fee and document claims.</p>
    <div class="notice">This page is a starter guide awaiting country-specific editorial verification. Do not rely on it as a complete application checklist.</div>
    <h2>Where to start</h2>
    <p>Review the applicable U.S. visa category on the <a href={usVisas.data.url}>Department of State website</a>. For location-specific instructions, use the <a href={pakistanVisas.data.url}>U.S. Mission Pakistan visa information</a> and follow the linked official scheduling instructions.</p>
    <h2>Questions we will cover</h2>
    <ul>
      <li>Which visitor visa category matches the genuine purpose of travel?</li>
      <li>Where do applicants find current DS-160 and interview instructions?</li>
      <li>Which rules depend on nationality, residence, or interviewing post?</li>
      <li>How should applicants handle discrepancies or support issues?</li>
    </ul>
  </div>
</Base>
